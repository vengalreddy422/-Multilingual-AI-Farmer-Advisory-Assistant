# ========================================================
# 🌾 KISAN MITRA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================

# 1. Google Gemini AI API Keys (Dual Key Failover Pool)
GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_API_KEY_2=your_backup_gemini_api_key_here

# 2. Email SMTP Server Configuration (Live Automated Dispatch)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
DEFAULT_SENDER=your_email@gmail.com

# 3. Application Settings
APP_NAME=Kisan Mitra AI
APP_ENV=production
DEBUG=False
